# Полный тест всех команд Этапов 1-3. Запускать с VFS examples/vfs/deep:
#   ./run.sh --vfs examples/vfs/deep --script examples/startup_full.emu
# Скрипт останавливается на первой ошибке, поэтому последняя строка с
# ошибкой стоит в конце: она показывает обработку ошибок при работе с VFS.

# --- Этап 1: команды-заглушки ls и cd, разбор аргументов ---
ls
ls -l /home
ls "my documents" 'a b' plain
ls ""
ls a\ b
ls "say \"hi\"" 'it''s'
cd
cd /tmp
cd "/tmp/new folder"

# --- Этап 3: служебные команды работы с VFS ---
vfs-info
vfs-tree
vfs-tree /
vfs-tree /level1
vfs-tree /level1/level2/level3
vfs-tree /level1/level2/level3/level4/four.txt
vfs-tree level1/level2
vfs-tree /level1/level2/../one.txt
vfs-tree "/level1/./level2/level3"
vfs-tree ..

# --- Обработка ошибок: на этой строке скрипт останавливается ---
vfs-tree /no/such/path
ls NEVER_PRINTED
